{
  "name": "@union-officer-academy/officer-context-compilation-service",
  "version": "0.1.6",
  "private": false,
  "type": "module",
  "description": "Compiles purpose-specific, locale-invariant source-addressed officer loadouts with bounded omissions, separate authority classes and typed refusal.",
  "keywords": [
    "capability-cell",
    "context-engineering",
    "agent-orchestration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harmonious-union/officer-context-compilation-service.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/compile.mjs",
    "./client": "./src/client.mjs"
  },
  "bin": {
    "compile-officer-context": "./scripts/compile-officer-context.mjs",
    "serve-officer-context-compilation": "./scripts/server.mjs",
    "serve-officer-context-compilation-activitypub": "./scripts/activitypub-server.mjs"
  },
  "files": [
    "scripts",
    "content/contracts",
    "content/schemas",
    "examples",
    "src",
    "types"
  ],
  "types": "./types/index.d.mts",
  "scripts": {
    "check": "node --check src/canonical.mjs && node --check src/schema.mjs && node --check src/compile.mjs && node --check src/client.mjs && node --check src/journal.mjs && node --check src/protocol.mjs && node --check src/activitypub-offer.mjs && node --check scripts/compile-officer-context.mjs && node --check scripts/execute-a2a-task.mjs && node --check scripts/server.mjs && node --check scripts/activitypub-server.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.7",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.1",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.2",
    "@red-cup-engineering/a2a-sovereign-operation-boundary-service": "1.0.2",
    "@red-cup-engineering/activitypub-services-section": "1.0.4",
    "@red-cup-engineering/ni-uri-services-section": "0.1.1",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.2",
    "@red-cup-engineering/json-services-section": "0.4.0",
    "@red-cup-engineering/json-schema-services-section": "0.5.0"
  }
}
