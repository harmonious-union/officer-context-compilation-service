{
  "name": "@harmonious-union/officer-context-compilation-service",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Compiles one reproducible purpose-specific officer context from exact Leader source, office law, admitted character chronicle, and authority-classified materials, or returns a typed refusal.",
  "keywords": [
    "capability-cell",
    "context-engineering",
    "agent-orchestration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harmonious-union/officer-context-compilation-service.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/compile.mjs",
    "./client": "./src/client.mjs"
  },
  "bin": {
    "compile-officer-context": "./bin/compile-officer-context.mjs",
    "serve-officer-context-compilation": "./bin/server.mjs",
    "serve-officer-context-compilation-activitypub": "./bin/activitypub-server.mjs"
  },
  "files": [
    "bin",
    "content/contracts",
    "content/schemas",
    "src",
    "types"
  ],
  "types": "./types/index.d.mts",
  "scripts": {
    "check": "node --check src/canonical.mjs && node --check src/schema.mjs && node --check src/compile.mjs && node --check src/client.mjs && node --check src/journal.mjs && node --check src/protocol.mjs && node --check src/activitypub-offer.mjs && node --check bin/compile-officer-context.mjs && node --check bin/execute-a2a-task.mjs && node --check bin/server.mjs && node --check bin/activitypub-server.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@emsenn/a2a-contracted-agent-service": "file:../../../../../red-cup-engineering/services/web-services-section/services/a2a-services-section/services/a2a-contracted-agent-service",
    "@emsenn/a2a-rmn-part-service": "file:../../../../../red-cup-engineering/services/web-services-section/services/a2a-services-section/services/a2a-rmn-part-service",
    "@emsenn/a2a-rmn-task-client-service": "file:../../../../../red-cup-engineering/services/web-services-section/services/a2a-services-section/services/a2a-rmn-task-client-service",
    "@emsenn/a2a-sovereign-operation-boundary-service": "file:../../../../../red-cup-engineering/services/web-services-section/services/a2a-services-section/services/a2a-sovereign-operation-boundary-service",
    "@emsenn/activitypub-services-section": "file:../../../../../red-cup-engineering/services/web-services-section/services/activitypub-services-section",
    "@emsenn/rmn-semantic-conformance": "file:../../../../../red-cup-engineering/services/model-services-section/services/relational-model-services-section/services/relational-model-notation-services-section/services/rmn-conformance-service"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "officer-context-compilation-service",
    "actor": "urn:ame:officer-context-compilation-service",
    "owners": [
      "officer-context-compilation-service"
    ],
    "admission": "one by-value officer context compilation request carrying exact content-addressed sources and an attenuated authority boundary",
    "refusal": "malformed request, source identity mismatch, contradictory identity reuse, missing Leader source, missing office or character epoch, or authority ambiguity",
    "operation-catalog": {
      "compile-officer-context": {
        "contract": "content/contracts/compile-officer-context.rml",
        "accepts": "content/schemas/input.schema.json",
        "returns": "content/schemas/output.schema.json",
        "refuses": "content/schemas/refusal.schema.json",
        "state": "content/schemas/state.schema.json"
      }
    }
  }
}
