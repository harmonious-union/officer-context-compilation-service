{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actions.561.group/officer-context-compilation/schemas/refusal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "requestId", "code", "reason", "field"],
  "properties": {
    "type": {"const": "OfficerContextCompilationRefusal"},
    "requestId": {"type": "string", "minLength": 1},
    "code": {"enum": ["E_SCHEMA", "E_IDENTITY", "E_CONTRADICTION", "E_AUTHORITY"]},
    "reason": {"type": "string", "minLength": 1},
    "field": {"type": "string", "minLength": 1}
  }
}
